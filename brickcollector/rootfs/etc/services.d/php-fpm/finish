#!/command/with-contenv bashio
# ==============================================================================
# Уронил php-fpm — роняем и контейнер: nginx без него отдаёт только 502.
# ==============================================================================
declare exit_code="${1}"

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "php-fpm завершился с кодом ${exit_code}, останавливаю аддон"
    exec /run/s6/basedir/bin/halt
fi
