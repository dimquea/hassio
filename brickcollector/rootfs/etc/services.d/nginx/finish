#!/command/with-contenv bashio
# ==============================================================================
# Упал nginx — панель всё равно недоступна, останавливаем аддон.
# ==============================================================================
declare exit_code="${1}"

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "nginx завершился с кодом ${exit_code}, останавливаю аддон"
    exec /run/s6/basedir/bin/halt
fi
